# Iris Morning - neutral light - base skin
#
# Fonts
%Fl(2,11-Inter-SemiBold.fnt)
%Fl(3,12-Inter-Regular.fnt)
%Fl(4,16-Inter-Bold.fnt)
%Fl(5,60-Inter-SemiBold.fnt)
#
# rotated clock strips
%xl(cm,clock-m.bmp,10,0,60)
%xl(ch,clock-h24.bmp,10,12,24)
%xl(cj,clock-h12.bmp,10,12,12)
#
# lock screen logic
%?mh<%VI(h)|%VI(m)>
%?mh<%Vd(lkbg)%Vd(lkc)%Vd(lkd)%?if(%mp, >, 1)<%Vd(lkb)%Vd(lkt)%Vd(lka)%Vd(lke)%Vd(lkp)%Vd(lkr)>|%?if(%cs, =, 2)<%Vd(tbnp)|%?if(%mp, >, 1)<%Vd(tbsa)%Vd(tbst)>>>
#
# playback state dot: playing circle, paused hollow square, stopped solid square
%?if(%mp, =, 3)<%Vd(psu)|%?if(%mp, >, 1)<%Vd(psp)|%Vd(pss)>>
#
# ---------------- Sidebar ----------------
%V(0,0,28,240,-)
%Vf(887c90)
%Vb(e8e8e0)
%dr(11,8,6,6,887c90)
#
# playback dot, playing - solid circle
%Vl(psp,11,8,6,6,-)
%Vb(e8e8e0)
%dr(1,0,4,6,887c90)
%dr(0,1,6,4,887c90)
#
# playback dot, paused - hollow square
%Vl(psu,11,8,6,6,-)
%Vb(e8e8e0)
%dr(0,0,6,6,887c90)
%dr(1,1,4,4,e8e8e0)
#
# playback dot, stopped - solid square
%Vl(pss,11,8,6,6,-)
%Vb(e8e8e0)
%dr(0,0,6,6,887c90)
#
# volume bar
%V(11,110,6,56,-)
%Vf(887c90)
%Vb(d8d8d0)
%pv(0,0,6,56,vertical,noborder)
#
# clock HH:MM, rotated 90 deg CCW
%V(0,177,28,27,-)
%Vb(e8e8e0)
%xd(cm,%cM,1)
%?cf<%xd(ch,%cH,1)|%xd(cj,%cl)>
#
# battery pill, rotated 90 deg CCW
%V(0,215,28,18,-)
%Vf(787480)
%Vb(e8e8e0)
%dr(12,0,4,2,787480)
%dr(10,2,8,16,787480)
%dr(11,3,6,14,e8e8e0)
%bl(12,4,4,12,noborder)
#
# ---------------- Topbar ----------------
%V(28,0,292,18,-)
%Vb(f0f0e8)
%dr(0,17,292,1,d8d8d0)
#
# screen title
%V(38,3,165,12,2)
%Vf(787480)
%Vb(f0f0e8)
%al%?mh<L O C K E D|%?cs<R O C K B O X|N O W  P L A Y I N G|R E C O R D I N G|F M  R A D I O|P L A Y L I S T|S E T T I N G S|F I L E S|D A T A B A S E|P L U G I N S|Q U I C K  S E T T I N G S|P I T C H|%Lt|P L A Y L I S T S|P L U G I N|M E N U|S Y S T E M|T I M E  &  D A T E|B O O K M A R K S|S H O R T C U T S|T R A C K  I N F O|U S B|%Lt>>
#
# topbar: playlist position on WPS
%Vl(tbnp,-80,3,72,13,3)
%Vf(787480)
%Vb(f0f0e8)
%ar%pp / %pe
#
# topbar: now playing info + album thumb
%Vl(tbsa,300,3,12,12,-)
%Vb(f0f0e8)
%Cl(0,0,12,12,c,c)
%Cd
#
%Vl(tbst,165,3,132,13,3)
%Vf(787480)
%Vb(f0f0e8)
%s%ar%?it<%it|%fn>%?ia< — %ia|>
#
# ---------------- Lists ----------------
%Vi(m,28,18,292,222,-)
%Vf(585460)
%Vb(f0f0e8)
#
# collapsed 1x1 stub used while locked
%Vi(h,28,18,1,1,-)
%Vf(f0f0e8)
%Vb(f0f0e8)
#
# ---------------- Lock screen ----------------
%Vl(lkbg,28,18,292,222,-)
%Vb(f0f0e8)
%dr(0,0,292,222,f0f0e8)
#
%Vl(lkc,28,58,292,64,5)
%Vf(585460)
%Vb(f0f0e8)
%ac%?cf<%cH|%cl>:%cM
#
%Vl(lkd,28,126,292,12,2)
%Vf(787480)
%Vb(f0f0e8)
%ac%ca %cd %cb
#
# bottom strip: track info and seek bar
%Vl(lkb,28,190,292,50,-)
%Vb(f8f8f0)
%dr(0,0,292,1,d8d8d0)
#
%Vl(lkt,40,196,268,18,4)
%Vf(585460)
%Vb(f8f8f0)
%s%al%?it<%it|%fn>
#
%Vl(lka,40,215,268,13,3)
%Vf(787480)
%Vb(f8f8f0)
%s%al%ia%?id< — %id|>
#
%Vl(lke,40,228,44,12,3)
%Vf(989498)
%Vb(f8f8f0)
%al%pc
#
%Vl(lkp,88,233,174,3,-)
%Vf(887c90)
%Vb(d8d8d0)
%pb(0,0,174,3,noborder)
#
%Vl(lkr,-54,228,46,12,3)
%Vf(989498)
%Vb(f8f8f0)
%ar%pt
